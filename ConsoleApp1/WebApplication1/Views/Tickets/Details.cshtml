@model HelpDeskApp.Models.Ticket

@{
    ViewData["Title"] = $"Ticket #{Model.Id} Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Ticket #@Model.Id: @Model.Subject</h2>
        <div>
            <span class="badge bg-primary">@Model.Priority.Name</span>
            <span class="badge bg-info text-dark">@Model.Status.Name</span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header">Description</div>
                <div class="card-body">
                    <p class="card-text">@Model.Description</p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">Comments (@Model.TicketComments.Count)</div>
                <div class="card-body">
                    @foreach (var comment in Model.TicketComments.OrderBy(c => c.CreatedAt))
                    {
                        <div class="border-bottom pb-2 mb-2">
                            <strong>@(comment.Employee != null ? $"{comment.Employee.FirstName} {comment.Employee.LastName}" : "System")</strong>
                            <small class="text-muted float-end">@comment.CreatedAt</small>
                            <p class="mb-1 mt-1">@comment.Comment</p>
                            @if (comment.IsInternal)
                            {
                                <span class="badge bg-warning text-dark">Internal Note</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">Attachments (@Model.TicketAttachments.Count)</div>
                <ul class="list-group list-group-flush">
                    @foreach (var att in Model.TicketAttachments)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@att.FileName (@att.ContentType)</span>
                            <span class="badge bg-secondary">@(att.FileSize / 1024) KB</span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header">Ticket Metadata</div>
                <div class="card-body">
                    <p><strong>Customer:</strong> @Model.Customer.CompanyName (@Model.Customer.ContactName)</p>
                    <p><strong>Category:</strong> @Model.Category.Name</p>
                    <p><strong>Created:</strong> @Model.CreatedAt</p>
                    <p><strong>Due:</strong> @(Model.DueAt ?? "Not Specified")</p>
                    <p><strong>Resolved:</strong> @(Model.ResolvedAt ?? "Pending")</p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">Assigned Staff</div>
                <ul class="list-group list-group-flush">
                    @foreach (var assign in Model.TicketAssignments.Where(a => a.UnassignedAt == null))
                    {
                        <li class="list-group-item">
                            @assign.Employee.FirstName @assign.Employee.LastName
                            @if (assign.IsPrimary)
                            {
                                <span class="badge bg-success float-end">Primary</span>
                            }
                        </li>
                    }
                </ul>
            </div>

            <div class="card mb-3">
                <div class="card-header">Tags</div>
                <div class="card-body">
                    @foreach (var tt in Model.TicketTags)
                    {
                        <span class="badge bg-secondary">@tt.Tag.Name</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>