@model IEnumerable<HelpDeskApp.ViewModels.DepartmentWorkloadViewModel>

@{
    ViewData["Title"] = "Department Workload";
}

<div class="container mt-4">
    <h2>Department Workload</h2>
    <table class="table table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Department</th>
                <th>Total Employees</th>
                <th>Unresolved Tickets</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.DepartmentName</td>
                    <td>@row.EmployeeCount</td>
                    <td>
                        <span class="badge @(row.UnresolvedTicketCount > 0 ? "bg-danger" : "bg-secondary")">
                            @row.UnresolvedTicketCount
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>